# Copy to .env.local. Never commit a populated environment file.
MONGODB_URI=mongodb://127.0.0.1:27017/memeostan
# Optional; government enforcement works with fallback text without a key.
MOONSHOT_API_KEY=
MEMEOSTAN_DAILY_TOKEN_CAP=60000
# Origin for citation preview links; set your HTTPS origin in production.
MEMEOSTAN_PUBLIC_URL=http://localhost:3000
# Development only: compress one hour into one minute.
MEMEOSTAN_FAST_CLOCK=0
# Keep enabled (0) on a persistent Node server.
MEMEOSTAN_DISABLE_WORLD_CLOCK=0
