nation.example.com {
	encode zstd gzip

	# The app itself listens on loopback; only Caddy faces the internet.
	reverse_proxy 127.0.0.1:3000

	# Hashed asset filenames are safe to cache hard. Everything else is live.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# The nation must never be served stale.
	@api path /api/*
	header @api Cache-Control "no-store"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# Log to stderr, which systemd captures — same as the other site on this box.
	# A file sink needs the directory to be writable by Caddy's own user, and
	# getting that wrong fails the whole config reload, taking every other site
	# on the server down with it. journalctl -u caddy is where these end up.
	log {
		output stderr
		format json
	}
}
